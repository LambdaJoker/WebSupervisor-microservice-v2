# WebSupervisor 本地环境变量模板
# 复制为 .env 后，Rust GUI 启动时会自动读取它，并将变量传给 Go 子服务。
# .env 只保存在本机，已被 .gitignore 忽略；不要填写后提交到 GitHub。
# PowerShell 可直接执行：
#   $env:QQ_MAIL_ACCOUNT_1134 = "你的发件邮箱"
#   $env:QQ_MAIL_PASSWORD_1134 = "邮箱授权码"
#   $env:QQ_MAIL_ACCOUNT_2667 = "监控通知收件邮箱"

QQ_MAIL_ACCOUNT_1134=
QQ_MAIL_PASSWORD_1134=
QQ_MAIL_ACCOUNT_2667=